      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entry Id"
    },
    "bank": {
      "minimum": 0,
      "title": "Bank",
      "type": "integer"
    },
    "free_transfers": {
      "maximum": 5,
      "minimum": 0,
