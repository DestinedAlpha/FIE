      "anyOf": [
        {
          "enum": [
            "wildcard",
            "freehit",
            "bboost",
            "3xc"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Chip"
    },
    "points": {
      "default": 0,
      "title": "Points",
      "type": "integer"
    },
    "transfers_made": {
      "default": 0,
      "maximum": 20,
      "minimum": 0,
      "title": "Transfers Made",
      "type": "integer"
    },
    "hit_paid": {
      "default": 0,
      "minimum": 0,
      "title": "Hit Paid",
      "type": "integer"
    },
    "deadline_lots": {
