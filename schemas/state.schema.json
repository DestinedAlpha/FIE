          "title": "Player Id",
          "type": "integer"
        },
        "purchase_price": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purchase Price"
        },
        "sell_price": {
          "minimum": 0,
          "title": "Sell Price",
          "type": "integer"
        },
        "quote_market_price": {
          "minimum": 0,
          "title": "Quote Market Price",
          "type": "integer"
        },
        "provenance": {
          "default": "manual",
