        "chip": {
          "enum": [
            "wildcard",
            "freehit",
            "bboost",
            "3xc"
          ],
          "title": "Chip",
          "type": "string"
        },
        "event": {
          "maximum": 38,
          "minimum": 1,
          "title": "Event",
          "type": "integer"
        }
      },
      "required": [
        "chip",
        "event"
      ],
      "title": "ChipUse",
      "type": "object"
    },
    "Lot": {
