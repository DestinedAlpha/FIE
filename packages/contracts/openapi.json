              "type": "integer"
            },
            "type": "array",
            "title": "Buy"
          },
          "chip": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "wildcard",
                  "freehit",
                  "bboost",
                  "3xc"
