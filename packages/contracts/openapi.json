            "title": "Parameter"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 8,
            "title": "Reason"
          },
          "expires_at": {
            "type": "string",
            "title": "Expires At"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Ids"
          },
          "known_at": {
            "type": "string",
            "title": "Known At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "player_id",
          "parameter",
          "value",
          "reason",
          "expires_at",
          "known_at"
        ],
        "title": "Belief"
      },
      "ChipUse": {
        "properties": {
          "chip": {
            "type": "string",
            "enum": [
              "wildcard",
              "freehit",
              "bboost",
              "3xc"
            ],
            "title": "Chip"
          },
          "event": {
            "type": "integer",
            "maximum": 38.0,
            "minimum": 1.0,
            "title": "Event"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "chip",
          "event"
        ],
        "title": "ChipUse"
      },
      "Claim": {
        "properties": {
          "player_id": {
            "type": "integer",
            "title": "Player Id"
          },
          "claim_type": {
            "type": "string",
            "enum": [
              "unavailable",
              "available",
              "training",
              "minutes_restriction",
              "role_change",
              "set_piece",
              "suspension",
              "fixture_change",
              "lineup"
            ],
            "title": "Claim Type"
          },
          "statement": {
            "type": "string",
            "maxLength": 1200,
            "minLength": 3,
            "title": "Statement"
          },
          "evidence_span": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 3,
            "title": "Evidence Span"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "source_hash": {
            "type": "string",
            "title": "Source Hash"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "known_at": {
            "type": "string",
            "title": "Known At"
          },
          "expires_at": {
            "type": "string",
            "title": "Expires At"
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "reported",
              "inferred",
              "speculative"
            ],
            "title": "Status"
          },
          "affected_events": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Affected Events"
          },
          "supersedes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supersedes"
          },
          "contradicts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Contradicts"
          },
          "origin": {
            "type": "string",
            "title": "Origin"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "player_id",
          "claim_type",
          "statement",
          "evidence_span",
          "source_url",
          "source_hash",
          "known_at",
          "expires_at",
          "status",
          "origin"
        ],
        "title": "Claim"
      },
      "ClaimInput": {
        "properties": {
          "claim": {
            "$ref": "#/components/schemas/Claim"
          },
          "source_text": {
            "type": "string",
            "maxLength": 60000,
            "title": "Source Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "claim",
          "source_text"
        ],
        "title": "ClaimInput"
      },
