        "type": "object",
        "title": "Action"
      },
      "Belief": {
        "properties": {
          "player_id": {
            "type": "integer",
            "title": "Player Id"
          },
          "parameter": {
            "type": "string",
            "enum": [
              "p_start",
              "goals90",
              "assists90",
